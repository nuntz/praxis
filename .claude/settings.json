{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "if": "Bash(gh issue close *)",
            "command": "bun \"$CLAUDE_PROJECT_DIR/lint/before-close.ts\"",
            "timeout": 60,
            "statusMessage": "Checking no comment names the ticket"
          }
        ]
      }
    ]
  }
}
