{
  "name": "praxis",
  "private": true,
  "type": "module",
  "packageManager": "bun@1.4.4",
  "workspaces": [
    "packages/*",
    "apps/*",
    "infra"
  ],
  "scripts": {
    "check": "biome check .",
    "ci": "biome ci --colors=off . && bun run typecheck && bun run test:lint && bun run test:deploy && bun run check:tickets && bun run test:domain && bun run test:pwa && bun run test:worker && bun run test:e2e",
    "typecheck": "bun run --filter '*' typecheck && tsc -p lint && tsc -p e2e && tsc -p scripts",
    "test:lint": "bun test ./lint",
    "test:deploy": "bun test ./infra ./scripts",
    "check:tickets": "bun lint/tickets.ts",
    "test:domain": "bun test --cwd packages/domain",
    "test:pwa": "bun test --cwd apps/pwa",
    "test:worker": "bun run --cwd apps/worker test",
    "test:e2e": "playwright test",
    "test:e2e:stress": "PRAXIS_E2E_STRESS=1 playwright test --repeat-each=8 --workers=16",
    "test:e2e:runner": "taskset -c 0-1 bun run test:e2e:stress",
    "build": "bun run --cwd apps/pwa build",
    "dev": "bun run build && bun run --cwd apps/worker dev",
    "evals": "bun run --cwd apps/worker evals",
    "wizard": "bash scripts/setup-deployment.sh",
    "trust:pulumi-ci": "bun scripts/trust-pulumi-ci.ts"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@biomejs/biome": "2.6.8",
    "@modelcontextprotocol/client": "2.4.0",
    "@playwright/test": "1.65.1",
    "@praxis/domain": "workspace:*",
    "@types/bun": "1.4.4",
    "typescript": "7.0.2"
  }
}
