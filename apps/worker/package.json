    "@praxis/domain": "workspace:*"
  },
  "devDependencies": {
    "@cloudflare/vitest-plugin": "1.8.2",
    "@modelcontextprotocol/client": "2.4.0",
    "vitest": "5.1.0",
    "wrangler": "4.162.0"
  }
