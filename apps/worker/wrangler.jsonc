{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "praxis",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-01",
  "assets": {
    "directory": "../pwa/dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  },
  "durable_objects": {
    "bindings": [{ "name": "CONTEXT", "class_name": "ContextObject" }]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["ContextObject"] }]
}
