{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "praxis",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-01",
  "assets": {
    "directory": "../pwa/dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    // Every request goes through the Worker first, so none reaches the screen without the
    // Access sign-in (section 7.1).
    "run_worker_first": true
  },
  // The Access application the Deployment sits behind: its team's domain, such as
  // https://<team>.cloudflareaccess.com, and the application's audience tag. Neither is a secret.
  // The setup wizard gives each Deployment its own; with none named the Worker lets nothing in.
  // JURISDICTION is where every object of the Deployment is kept: "eu", "us" or "fedramp", or none
  // when empty. The wizard offers it once, and a deploy that would change it fails (section 9.2).
  // AGENT_MODEL is the Agent's model, one the code ships a price for, or the default when empty.
  // PUSH_PUBLIC_KEY is the public half of the Web Push signing key pair the wizard makes, which a
  // browser subscribes with, and PUSH_SUBJECT the address the push services are told it is from:
  // the Deployment's own. With no key no Device can switch Notifications on.
  // A deploy gives each with --var (infra/index.ts), and one it leaves out is empty, as here.
  "vars": {
    "ACCESS_TEAM_DOMAIN": "",
    "ACCESS_AUD": "",
    "JURISDICTION": "",
    "AGENT_MODEL": "",
    "PUSH_PUBLIC_KEY": "",
    "PUSH_SUBJECT": ""
  },
  // The daily Backup (section 10.1): once a day the Worker asks the Deployment object for one.
  "triggers": { "crons": ["0 3 * * *"] },
  // Where the Backups are kept, on the person's account, which the setup wizard's Pulumi program
  // makes (infra/index.ts). A Deployment that chose a jurisdiction keeps its bucket there too, and
  // the deploy adds it to this binding (scripts/deploy-config.ts).
  // Workers AI and the meaning index's Vectorize index are bound by the deploy alone
  // (scripts/deploy-config.ts): a binding to either here reaches the account in every test.
  "r2_buckets": [{ "binding": "BACKUPS", "bucket_name": "praxis-backups" }],
  "durable_objects": {
    "bindings": [
      { "name": "CONTEXT", "class_name": "ContextObject" },
      { "name": "DEPLOYMENT", "class_name": "DeploymentObject" }
    ]
  },
  "migrations": [
    { "tag": "v1", "new_sqlite_classes": ["ContextObject"] },
    { "tag": "v2", "new_sqlite_classes": ["DeploymentObject"] }
  ]
}
