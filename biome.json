{
  "$schema": "./node_modules/@biomejs/biome/configuration_schema.json",
  "vcs": { "enabled": true, "clientKind": "git", "useIgnoreFile": true },
  "files": {
    "includes": [
      "**",
      "!**/dist",
      "!**/.wrangler",
      "!probes",
      "!test-results",
      "!playwright-report",
      "!apps/worker/test/fixtures",
      "!**/*.md"
    ]
  },
  "formatter": { "indentStyle": "space", "lineWidth": 100 },
  "linter": {
    "rules": { "preset": "recommended" }
  },
  "overrides": [
    {
      "includes": ["packages/domain/src/**", "apps/worker/src/**", "!apps/worker/src/arrival.ts"],
      "plugins": ["./lint/no-real-clock.grit"]
    },
    {
      "includes": ["apps/worker/src/**", "!apps/worker/src/routing.ts"],
      "plugins": ["./lint/outside-jurisdiction.grit"]
    },
    {
      "includes": ["packages/domain/src/**", "apps/worker/src/**", "apps/pwa/src/**"],
      "plugins": ["./lint/day-start.grit"]
    },
    {
      "includes": ["apps/pwa/src/**/*.css"],
      "plugins": ["./lint/pinned.grit"]
    },
    {
      "includes": ["e2e/**"],
      "plugins": ["./lint/exact-label.grit", "./lint/read-not-stood-in.grit"]
    },
    {
      "includes": ["apps/worker/test/**"],
      "plugins": ["./lint/fresh-marker.grit"]
    },
    {
      "includes": ["**/test/**", "**/*.test.ts", "e2e/**"],
      "plugins": ["./lint/assert-what-comes-back.grit"]
    },
    {
      "includes": ["apps/pwa/src/**"],
      "plugins": ["./lint/computed-on.grit", "./lint/use-only-reads.grit"]
    },
    {
      "includes": ["apps/pwa/src/**", "!apps/pwa/src/latest-read.ts"],
      "plugins": ["./lint/numbered-read.grit"]
    },
    {
      "includes": ["apps/pwa/src/**", "!apps/pwa/src/stored.ts"],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedGlobals": {
              "level": "error",
              "options": {
                "deniedGlobals": {
                  "localStorage": "What the screen stores for a later load goes through stored.ts, whose readers every shape a release stored is checked against (apps/pwa/test/stored.test.ts).",
                  "indexedDB": "What the screen stores for a later load goes through stored.ts, whose readers every shape a release stored is checked against (apps/pwa/test/stored.test.ts)."
                }
              }
            }
          }
        }
      }
    },
    {
      "includes": ["packages/domain/src/**"],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedImports": {
              "level": "error",
              "options": {
                "patterns": [
                  {
                    "group": ["bun", "bun:*", "cloudflare:*", "@cloudflare/*", "wrangler"],
                    "message": "The domain package imports nothing from Cloudflare or Bun."
                  }
                ]
              }
            }
          }
        }
      }
    },
    {
      "includes": [
        "apps/worker/test/**/*.test.ts",
        "!apps/worker/test/endpoint.test.ts",
        "!apps/worker/test/mcp.test.ts",
        "!apps/worker/test/upgrade.test.ts",
        "!apps/worker/test/oracle-tables.test.ts",
        "!apps/worker/test/meaning-index.test.ts"
      ],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedImports": {
              "level": "error",
              "options": {
                "patterns": [
                  {
                    "group": ["cloudflare:test", "cloudflare:workers"],
                    "message": "A seam test reaches a Context only through newContext() in seam.ts, so every call goes through the oracle and no test reads tables or writes rows (ADR 0015). endpoint.test.ts and mcp.test.ts alone test the Worker's HTTP path, upgrade.test.ts alone lays an earlier release's tables in an object and reads where its ladder stands, oracle-tables.test.ts alone gives an object a table the oracle does not know, or a row keeping a removed record's words, and meaning-index.test.ts alone reads the meaning index's bindings, for its contract run by hand."
                  }
                ]
              }
            }
          }
        }
      }
    }
  ]
}
